# Xcode per-user state — window layout, breakpoints, scheme ordering.
# Machine-local, not project configuration: tracking it means every machine
# fights over the same file with changes nobody made deliberately.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/

# Dependency managers (unused today, cheap to pre-empt)
Pods/
Carthage/Build/

# macOS
.DS_Store
